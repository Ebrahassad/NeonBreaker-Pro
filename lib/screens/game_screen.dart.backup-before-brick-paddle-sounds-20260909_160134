  void _watchAdToContinue() {
    if (!AdService.instance.isRewardedReady) {
      if (mounted) {
        ScaffoldMessenger.of(context)
          ..hideCurrentSnackBar()
          ..showSnackBar(
            const SnackBar(
              content: Text('Ad is not available right now.'),
              duration: Duration(seconds: 2),
            ),
          );
      }
      return;
    }

    AdService.instance.showRewarded(
      onReward: () {
        if (!mounted || !_gameOver) return;

        // Rewarded ad grants one persistent yellow extra life.
        widget.save.addExtraLives(1);

        setState(() {
          _gameOver = false;
          _lives = 1;
        });

        // Restore the exact bricks that remained when the player lost.
        _bricks
          ..clear()
          ..addAll(
            _savedBricks.map(
              (brick) =>
                  Brick(x: brick.x, y: brick.y, type: brick.type, hp: brick.hp),
            ),
          );
        _resetBalls();
        _controller.repeat();

        if (mounted) {
          ScaffoldMessenger.of(context)
            ..hideCurrentSnackBar()
            ..showSnackBar(
              const SnackBar(
                content: Text('Reward granted! +1 🟡 Yellow Life'),
                duration: Duration(seconds: 2),
              ),
            );
        }
      },
    );
  }

