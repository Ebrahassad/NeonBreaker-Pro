  // MONETIZATION: OPTIONAL REWARDED-AD BOOSTS
  // ----------------------------------------------------------

  void _watchAdToContinue() {
    if (_continueUsed) return;

    AdService.instance.showRewarded(
      onReward: () {
        if (!mounted || !_gameOver) return;

        setState(() {
          _continueUsed = true;
          _gameOver = false;
          _lives = 1;
        });

        _resetBalls();
        _controller.repeat();
      },
    );
  }

  void _watchAdForDoubleBonus() {
    if (_doubleBonusUsed) return;

    AdService.instance.showRewarded(
      onReward: () {
        if (!mounted || !_levelClear) return;

        setState(() {
          _doubleBonusUsed = true;
          _score += _bonusScore;
        });

        widget.save.saveLevelScore(widget.level, _score);
      },
    );
  }

